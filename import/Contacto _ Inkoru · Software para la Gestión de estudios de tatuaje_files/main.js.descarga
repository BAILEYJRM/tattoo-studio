// Script para el menú móvil
document.addEventListener('DOMContentLoaded', function() {
    // Cerrar el menú al hacer clic en un enlace
    const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
    navLinks.forEach(link => {
        link.addEventListener('click', function() {
            const navbarCollapse = document.querySelector('.navbar-collapse');
            if (navbarCollapse.classList.contains('show')) {
                const bsCollapse = new bootstrap.Collapse(navbarCollapse);
                bsCollapse.hide();
            }
        });
    });

    // Cambio de grupos de estudios
    const studiosGroups = document.querySelectorAll('.studios-group');
    if (studiosGroups.length === 0) return;
    let currentGroupIndex = 0;
    let previousGroupIndex = 0;

    function switchStudiosGroup() {
        // Remover la clase active del grupo actual
        studiosGroups[currentGroupIndex].classList.remove('active');
        // Añadir la clase prev al grupo actual
        studiosGroups[currentGroupIndex].classList.add('prev');
        
        // Actualizar los índices
        previousGroupIndex = currentGroupIndex;
        currentGroupIndex = (currentGroupIndex + 1) % studiosGroups.length;
        
        // Remover la clase prev del nuevo grupo si existe
        studiosGroups[currentGroupIndex].classList.remove('prev');
        // Añadir la clase active al nuevo grupo
        studiosGroups[currentGroupIndex].classList.add('active');
        
        // Remover la clase prev del grupo anterior después de la transición
        setTimeout(() => {
            studiosGroups[previousGroupIndex].classList.remove('prev');
        }, 400);
    }

    // Cambiar cada 5 segundos
    setInterval(switchStudiosGroup, 5000);
});

// Script para cargar testimonios
// Función para crear el HTML de un testimonio
function crearTestimonioHTML(testimonio) {
    return `
        <article class="slider-item"
                 itemscope itemtype="https://schema.org/Review"
                 role="article">

            <div class="testimonio-texto" itemprop="reviewBody">
                ${testimonio.texto}
            </div>

            <div class="testimonio-autor">
                <img src="${testimonio.autor.avatar}"
                     alt="Avatar de ${testimonio.autor.nombre}"
                     class="autor-avatar"
                     itemprop="image">

                <div class="autor-info">
                    <div class="autor-nombre"
                         itemscope itemtype="https://schema.org/Person"
                         itemprop="author">
                        <span itemprop="name">${testimonio.autor.nombre}</span>
                    </div>
                    <div class="autor-estudio"
                         itemscope itemtype="https://schema.org/Organization"
                         itemprop="itemReviewed">
                        <span itemprop="name">${testimonio.autor.estudio}</span>
                    </div>
                </div>
            </div>

            <meta itemprop="datePublished"
                  content="${testimonio.fecha || new Date().toISOString()}">

            <div itemprop="reviewRating"
                 itemscope itemtype="https://schema.org/Rating">
                <meta itemprop="ratingValue" content="${testimonio.rating}">
                <meta itemprop="bestRating"  content="5">
                <meta itemprop="worstRating" content="1">
            </div>

        </article>
    `;
}


// Función para cargar y distribuir los testimonios
async function cargarTestimonios() {
    try {
        const response = await fetch('assets/data/testimonios.json');
        const data = await response.json();
        const testimonios = data.testimonios;
        
        // Obtener todos los contenedores de slider
        const contenedores = document.querySelectorAll('.contenedor-slider');
        const numColumnas = contenedores.length; // 5 columnas
        
        // Para cada contenedor, crear una copia de los testimonios empezando en un punto diferente
        contenedores.forEach((contenedor, index) => {
            const slider = contenedor.querySelector('.slider');
            let htmlTestimonios = '';
            
            // Con 25 testimonios y 5 columnas, cada columna empezará 5 posiciones después
            // Columna 1: empieza en 0
            // Columna 2: empieza en 5
            // Columna 3: empieza en 10
            // Columna 4: empieza en 15
            // Columna 5: empieza en 20
            const offset = (index * 5) % testimonios.length;
            
            // Reordenamos los testimonios para esta columna
            let testimoniosReordenados = [
                ...testimonios.slice(offset),
                ...testimonios.slice(0, offset)
            ];
            
            // Crear tres copias de los testimonios reordenados para asegurar el bucle infinito
            for (let i = 0; i < 3; i++) {
                testimoniosReordenados.forEach(testimonio => {
                    htmlTestimonios += crearTestimonioHTML(testimonio);
                });
            }
            
            slider.innerHTML = htmlTestimonios;
        });
        
        // Inicializar los sliders después de cargar el contenido
        inicializarSliders();
    } catch (error) {
        console.error('Error al cargar los testimonios:', error);
    }
}

// Función para inicializar los sliders
function inicializarSliders() {
    document.querySelectorAll('.contenedor-slider').forEach(columna => {
        let slider = columna.querySelector('.slider');
        
        // Duplicamos los items para el bucle infinito
        let htmlOriginal = slider.innerHTML;
        slider.innerHTML += htmlOriginal;
        
        // Función para calcular la altura total y configurar el bucle
        function configurarSlider() {
            // Obtenemos todos los items
            let items = slider.querySelectorAll('.slider-item');
            let alturaTotal = 0;
            let alturas = [];
            
            // Calculamos la altura total y guardamos las alturas individuales
            items.forEach(item => {
                let altura = item.offsetHeight + 20; // 20px es el gap
                alturaTotal += altura;
                alturas.push(altura);
            });
            
            // La mitad de los items (los originales)
            let halfHeight = alturaTotal / 2;
            
            // Definimos la dirección
            let direccion = columna.getAttribute('data-direction');
            
            // Offset inicial
            let offset = (direccion === 'down') ? -halfHeight : 0;
            
            // Velocidad
            let velocidadBase = 0.5;
            let velocidadActual = velocidadBase;
            let velocidadObjetivo = velocidadBase;
            
            // Eventos de hover
            columna.addEventListener('mouseenter', () => {
                velocidadObjetivo = 0;
            });
            columna.addEventListener('mouseleave', () => {
                velocidadObjetivo = velocidadBase;
            });
            
            // Función de animación
            function animar() {
                velocidadActual += (velocidadObjetivo - velocidadActual) * 0.1;
                
                if (direccion === 'up') {
                    offset -= velocidadActual;
                    if (offset <= -halfHeight) {
                        offset += halfHeight;
                    }
                } else {
                    offset += velocidadActual;
                    if (offset >= 0) {
                        offset -= halfHeight;
                    }
                }
                
                slider.style.transform = `translateY(${offset}px)`;
                requestAnimationFrame(animar);
            }
            
            animar();
        }
        
        // Configuramos el slider inicialmente
        configurarSlider();
        
        // Reconfiguramos cuando cambia el tamaño de la ventana
        window.addEventListener('resize', configurarSlider);
    });
}

// Cargar los testimonios cuando el DOM esté listo
document.addEventListener('DOMContentLoaded', cargarTestimonios); 