/**
 * Script para controlar la animación del logo INKORU
 */

document.addEventListener('DOMContentLoaded', function() {
    const logoContainer = document.querySelector('.logo-container');

    // Añadir funcionalidad para reiniciar la animación al hacer clic en el logo
    logoContainer.addEventListener('click', function(e) {
        //e.preventDefault(); // Evitar el comportamiento de enlace por defecto

        // Añadir clase para reiniciar animación
        logoContainer.classList.add('replay-animation');
        
        // Pequeño timeout para asegurar que la transición se aplica
        setTimeout(() => {
            logoContainer.classList.add('animate');
        }, 10);

        // Eliminar clases después de que la animación se complete
        setTimeout(() => {
            logoContainer.classList.remove('replay-animation', 'animate');
        }, 3000);
    });
}); 